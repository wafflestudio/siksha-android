<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="2.5dp"
    android:orientation="horizontal"
    >

    <LinearLayout
        android:id="@+id/filter_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/frame_menu_filter_field"
        android:paddingHorizontal="6dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_check_simple"
            app:tint = "@color/gray_800" />

        <TextView
            android:id="@+id/filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="가격"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="@font/nanum_square_regular"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:gravity="center" />

        <ImageView
            android:id="@+id/arrow_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_filter_down"
            app:tint = "@color/gray_700" />

    </LinearLayout>
</LinearLayout>