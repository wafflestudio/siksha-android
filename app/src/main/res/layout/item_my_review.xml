<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_primary"
    android:layout_marginTop="16dp"
    android:layout_marginStart="4dp"
    android:clipToOutline="true">

    <!-- ✅ 상단 영역 (메뉴명 + 별점 + 날짜) -->
    <LinearLayout
        android:id="@+id/reviewHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:background="@drawable/bg_review_header"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/menuName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="쇠고기카레라이스"
                    android:textSize="15sp"
                    android:fontFamily="@font/nanum_square_extra_bold"
                    android:textColor="@color/black"
                    android:lineSpacingExtra="3sp"
                    />

                <ImageView
                    android:id="@+id/arrowIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/review_arrow_right"/>
            </LinearLayout>


            <TextView
                android:id="@+id/reviewDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024년 4월 11일"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />
        </LinearLayout>

        <!-- 별점 -->
        <LinearLayout
            android:id="@+id/stars_container"
            android:layout_width="61dp"
            android:layout_height="10dp"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"/>
    </LinearLayout>

    <!-- 리뷰 내용 -->
    <TextView
        android:id="@+id/reviewContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="학교 생활의 낙을 담당하는 맛!! 이거 먹으려고 학교 다닙니다 ㅎㅎ"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="4dp"
        android:lineSpacingExtra="2dp"
        />

    <!-- 태그 -->
    <LinearLayout
        android:id="@+id/reviewTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="4dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/reviewTag1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="또 먹고 싶어요"
            android:textSize="12sp"
            android:textColor="@color/gray_700"
            android:padding="4dp"
            android:background="@drawable/bg_review_tag"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/reviewTag2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="가성비 좋아요"
            android:textSize="12sp"
            android:textColor="@color/gray_700"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_review_tag"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/reviewTag3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="알찬 편이에요"
            android:textSize="12sp"
            android:textColor="@color/gray_700"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_review_tag"/>
    </LinearLayout>

    <!-- 하단: 수정 / 삭제 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="삭제하기"
            android:textColor="@color/gray_600"
            android:textSize="11sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/editButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="수정하기"
            android:textColor="@color/orange_500"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
