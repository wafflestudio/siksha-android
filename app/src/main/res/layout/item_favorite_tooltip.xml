<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_tooltip"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:layout_gravity="end"
    android:orientation="vertical"
    android:padding="0dp">

    <ImageView
        android:id="@+id/tooltip_triangle"
        android:layout_width="9dp"
        android:layout_height="7dp"
        android:layout_gravity="start"
        android:layout_marginStart="110dp"
        android:src="@drawable/bg_favorite_tooltip_triangle" />

    <TextView
        android:id="@+id/text_tooltip"
        android:layout_width="137dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_favorite_tooltip_bubble"
        android:gravity="center"
        android:text="메뉴 알림을 받아보세요!"
        android:textColor="@color/gray_700"
        android:textSize="12sp"
        android:fontFamily="@font/nanum_square_bold" />
</LinearLayout>
